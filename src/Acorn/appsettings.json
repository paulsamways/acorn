{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataDirectory": "data",
  "FileSystemContentAddressedBlobStore": {
    "DirectoryPath": "blobs"
  },
  "DatabaseBackup": {
    "DirectoryPath": "backups",
    "RetentionCount": 14
  },
  "Telemetry": {
    "RetentionDays": 30,
    "MaxQueueSize": 2048
  },
  "Comments": {
    "ApprovalMode": "Admin"
  },
  "AllowedHosts": "*"
}
