<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] is null ? Constants.SiteName : ViewData["Title"] + " | " + Constants.SiteName)</title>

  <script type="importmap"></script>

  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
  <header class="p-4 f-row f-justify-space-between">

    <div>
      <h1>@Constants.SiteName</h1>
      <p class="muted">
        /// the pursuit of staying the course when the maps run out
      </p>
    </div>
    <nav>
      <a asp-route="@Routes.HomeIndexGetRoute">/home</a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a asp-route="@Routes.Admin.NotesIndexGetRoute">/admin</a>
      }
    </nav>

  </header>

  @RenderBody()

  <footer class="p-3 f-row">
    <div class="text-center f-grow-1 muted">
      &copy; Copyright @DateTime.Now.Year, Paul Samways
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <form asp-action="@Url.RouteUrl(Routes.AccountSignOutPostRoute)" method="POST">
        <button type="submit">Sign-out</button>
      </form>
    }
    else
    {
      <div>
        <a class="muted" asp-route="@Routes.AccountSignInGetRoute" target="_self">&pi;</a>
      </div>
    }
  </footer>

  <!-- <script src="~/js/pages/all.js" defer asp-append-version="true"></script> -->

  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
