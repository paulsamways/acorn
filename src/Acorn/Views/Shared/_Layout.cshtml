<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🖥️</text></svg>">
  <title>@(ViewData["Title"] is null ? Constants.SiteName : ViewData["Title"] + " | " + Constants.SiteName)</title>

  <script type="importmap"></script>

  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
  <header class="p-4 f-row f-justify-space-between">

    <div>
      <h1>paul<span class="muted">.</span>samways<span class="muted">.id.au</span></h1>
    </div>
    <nav>
      <a asp-route="@Routes.HomeIndexGetRoute">/home</a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a asp-route="@Routes.Admin.NotesIndexGetRoute">/admin</a>
      }
    </nav>

  </header>

  @if (TempData.ContainsKey("Message"))
  {
    <div class="text-center b danger mr-4 ml-4 mb-4 p-2">
      @TempData["Message"]
    </div>
  }

  @RenderBody()

  <footer class="p-3 f-row f-align-center">
    <div class="f-1"></div>
    <div class="text-center f-3 muted">
      &copy; Copyright @DateTime.Now.Year, Paul Samways
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
      <form class="f-1 f-row f-justify-end" asp-route="@Routes.AccountSignOutPostRoute" method="POST">
        <button type="submit">Sign-out</button>
      </form>
    }
    else
    {
      <div class="f-1 text-right">
        <a class="muted" asp-route="@Routes.AccountSignInGetRoute" target="_self">&pi;</a>
      </div>
    }
  </footer>

  <!-- <script src="~/js/pages/all.js" defer asp-append-version="true"></script> -->

  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
