<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] is null ? Constants.Name : ViewData["Title"] + " | " + Constants.Name)</title>

  <script type="importmap"></script>

  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
  <header class="p-4 f-row f-justify-space-between">

    <div>
      <h1>an undulating journey</h1>
      <p class="muted">
        /// the pursuit of staying the course when the maps run out
      </p>
    </div>
    <nav>
      <a asp-route="@Routes.HomeIndexGetRoute">/home</a>
      <a asp-route="@Routes.AccountSignInGetRoute">/sign-in</a>
    </nav>

  </header>

  <main role="main">
    @RenderBody()
  </main>

  <footer class="p-3 f-row">
    <div class="text-center f-grow-1 muted">
      &copy; Copyright @DateTime.Now.Year, Paul Samways
    </div>
    <div>
      <a onclick="if (!(event.ctrlKey && event.shiftKey)) { event.preventDefault(); }" class="muted" asp-route="@Routes.AccountSignInGetRoute">&pi;</a>
    </div>
  </footer>

  <!-- <script src="~/js/pages/all.js" defer asp-append-version="true"></script> -->

  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
