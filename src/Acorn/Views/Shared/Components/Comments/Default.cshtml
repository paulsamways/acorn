@model Acorn.Models.Comments.CommentsViewModel

<section id="comments" class="f-column g-4" aria-label="Comments">
  <h2>Comments</h2>

  @if (Model.Comments.Count == 0)
  {
    <p class="muted">No comments yet.</p>
  }
  else
  {
    <div class="f-column g-4">
      @foreach (var comment in Model.Comments)
      {
        <partial name="~/Views/Comments/_Comment.cshtml" model="comment" />
      }
    </div>
  }

  <div class="f-column g-3">
    <h3>Leave a comment</h3>
    <partial name="~/Views/Comments/_CommentForm.cshtml" model="Model.Form" />

    @if (Model.Form.IsTrustedAuthor)
    {
      <form asp-route="@Routes.ContentCommentsForgetPostRoute" method="POST">
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + "#comments")" />
        <small class="muted">You won't be asked to verify again on this browser. <button type="submit" class="link">Not you? Forget me.</button></small>
      </form>
    }
  </div>
</section>
