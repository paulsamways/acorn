@model IEnumerable<Acorn.Core.ContentManagement.Models.Post>

<main class="f-column f-align-center">
  <section class="f-column w-wide g-4 p-4" aria-label="Posts">
    <h2>Posts</h2>
    @foreach (var post in Model)
    {
      <article class="f-column g-2">
        <header class="f-column g-1">
          <h3>
            <a asp-route="@Routes.ContentPostsDetailsGetRoute" asp-route-id="@post.Id">
              @(string.IsNullOrWhiteSpace(post.Title) ? "Untitled post" : post.Title)
            </a>
          </h3>
        </header>

        <div class="prose">@Html.Raw(post.ExcerptHtml ?? post.BodyHtml)</div>

        @await Html.PartialAsync("_ContentTags", post.Tags)
      </article>
    }
  </section>
</main>
