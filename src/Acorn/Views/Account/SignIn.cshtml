@model SignInViewModel

@{
  ViewData["Title"] = "Sign in";
}

<main class="f-grow-1 f-column f-align-center">

  <form class="w-480 f-column g-3" asp-route="@Routes.AccountSignInPostRoute"
        asp-route-returnurl="@ViewData[Acorn.Controllers.AccountController.ViewDataReturnUrl]" method="POST">

    <partial name="_ValidationSummary" />

    <div class="f-column">
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" placeholder="you@example.com" required
             autofocus="@string.IsNullOrWhiteSpace(Model.Email)" aria-validation />
    </div>

    <div class="f-column">
      <label asp-for="Password"></label>
      <input asp-for="Password" autocomplete="current-password" required
             autofocus="@(!string.IsNullOrWhiteSpace(Model.Email))" aria-validation />
    </div>

    <label>
      <input type="checkbox" asp-for="RememberMe">
      @Html.DisplayNameFor(m => m.RememberMe)
    </label>

    <button type="submit">Sign in</button>

    <p>
      <a asp-route="@Routes.AccountForgotPasswordGetRoute">
        Forgot your password?
      </a>
    </p>
  </form>
</main>
