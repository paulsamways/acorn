@model SignInViewModel

@{
  ViewData["Title"] = "Sign in";
}

<div class="container-narrow mt-5">
  <h2>Sign in</h2>

  <form class="f-column g-3 mt-3" asp-route="@Routes.AccountSignInPostRoute" asp-route-returnurl="@ViewData[Acorn.Controllers.AccountController.ViewDataReturnUrl]" method="POST">

    <partial name="_ValidationSummary" />

    <fieldset>
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" placeholder="you@example.com" required autofocus="@string.IsNullOrWhiteSpace(Model.Email)" aria-validation />

      <label asp-for="Password"></label>
      <input asp-for="Password" autocomplete="current-password" required autofocus="@(!string.IsNullOrWhiteSpace(Model.Email))" aria-validation />

      <label>
        <input type="checkbox" asp-for="RememberMe">
        @Html.DisplayNameFor(m => m.RememberMe)
      </label>
    </fieldset>

    <button type="submit">Sign in</button>

    <p>
      <a asp-route="@Routes.AccountForgotPasswordGetRoute">
        Forgot your password?
      </a>
    </p>
    <p>
      Don't have an account, <a asp-route="@Routes.AccountRegisterGetRoute">register now</a>.
    </p>
  </form>
</div>
