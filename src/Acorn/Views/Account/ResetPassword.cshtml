@model ResetPasswordViewModel
@{
  ViewData["Title"] = "Reset password";
}

<main class="f-grow-1 f-column f-align-center">

  <form class="w-480 f-column g-4" asp-route="@Routes.AccountResetPasswordPostRoute" method="POST">

    <input asp-for="Code" type="hidden" />

    <partial name="_ValidationSummary" />

    <div class="f-column">
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" placeholder="you@example.com" required aria-validation readonly />
    </div>
    <div class="f-column">
      <label asp-for="Password"></label>
      <input asp-for="Password" autocomplete="new-password" required aria-validation autofocus />
    </div>
    <div class="f-column">
      <label asp-for="ConfirmPassword"></label>
      <input asp-for="ConfirmPassword" autocomplete="new-password" required aria-validation />
    </div>

    <div class="mt-5 f-column">
      <button type="submit">Reset Password</button>
    </div>
  </form>
</main>
