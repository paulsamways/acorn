@model ResetPasswordViewModel
@{
  ViewData["Title"] = "Reset password";
}

<div class="container-narrow mt-5">
  <h2>Reset password</h2>

  <form class="f-column g-4 mt-3" asp-route="@Routes.AccountResetPasswordPostRoute" method="POST">

    <input asp-for="Code" type="hidden" />

    <partial name="_ValidationSummary" />

    <fieldset>
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" placeholder="you@example.com" required aria-validation readonly />

      <label asp-for="Password"></label>
      <input asp-for="Password" autocomplete="new-password" required aria-validation autofocus />

      <label asp-for="ConfirmPassword" class="block text-sm font-medium"></label>
      <input asp-for="ConfirmPassword" autocomplete="new-password" required aria-validation />
    </fieldset>

    <button type="submit">Reset Password</button>
  </form>
</div>
