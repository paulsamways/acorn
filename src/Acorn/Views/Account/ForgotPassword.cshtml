@model ForgotPasswordViewModel
@{
  ViewData["Title"] = "Forgot your password?";
}

<div class="container-narrow mt-5">
  <h2>Forgot your password?</h2>

  <form class="f-column g-3 mt-3" asp-route="@Routes.AccountForgotPasswordPostRoute" method="POST">

    <partial name="_ValidationSummary" />

    <fieldset>
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" required autofocus aria-validation>
    </fieldset>

    <button type="submit">
      Send Password Reset Link
    </button>

  </form>

</div>
