@model ForgotPasswordViewModel
@{
  ViewData["Title"] = "Forgot your password?";
}

<main class="f-grow-1 f-column f-align-center">
  <form class="w-480 f-column g-3" asp-route="@Routes.AccountForgotPasswordPostRoute" method="POST">

    <partial name="_ValidationSummary" />

    <div class="f-column">
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" required autofocus aria-validation>
    </div>

    <button type="submit">
      Send Password Reset Link
    </button>

  </form>

</main>
