@{
  ViewData["Title"] = "Reset password confirmation";
}

<main class="f-grow-1 f-column f-align-center">
  <p>
    Your password has been updated. You may now
    <a asp-route="@Routes.AccountSignInGetRoute" asp-route-email="@Model.Email">sign into your account</a> using your new password.
  </p>
</main>
