@model RegisterViewModel
@{
  ViewData["Title"] = "Register";
}

<main class="f-grow-1 f-column f-align-center">
  <form class="w-480 f-column g-3" asp-route="@Routes.AccountRegisterPostRoute" asp-route-returnurl="@ViewData[Acorn.Controllers.AccountController.ViewDataReturnUrl]" method="POST">

    <partial name="_ValidationSummary" />

    <div class="f-column">
      <label asp-for="Email"></label>
      <input asp-for="Email" autocomplete="email" placeholder="you@example.com" required aria-validation />
    </div>

    <button type="submit">Register</button>
  </form>
</main>

@section Scripts {
}
