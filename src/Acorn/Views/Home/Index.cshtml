@model IEnumerable<Acorn.Core.ContentManagement.Models.Post>

<main class="f-grow-1 f-column f-align-center">

  <section class="f-column w-wide g-4 p-4" aria-label="Published posts">
    <h2>Recent Posts</h2>
    @foreach (var post in Model)
    {
      <article class="f-column g-2">
        <header class="f-column g-1">
          <h3>
            <a asp-route="@Routes.PostsDetailsGetRoute" asp-route-id="@post.Id">
              @(string.IsNullOrWhiteSpace(post.Title) ? "Untitled post" : post.Title)
            </a>
          </h3>
          @if (post.PublishedAt is DateTimeOffset publishedAt)
          {
            <time class="muted" datetime="@publishedAt.ToString("O")">@publishedAt.ToString("MMMM d, yyyy")</time>
          }
        </header>

        <div class="prose">
          @Html.Raw(post.ExcerptHtml ?? post.BodyHtml)

          @if (post.ExcerptHtml is not null)
          {
            <a asp-route="@Routes.PostsDetailsGetRoute" asp-route-id="@post.Id">Continue reading</a>
          }
        </div>

        @if (post.Tags.Count > 0)
        {
          <div class="f-row f-justify-end g-2">
            @foreach (var tag in post.Tags.OrderBy(tag => tag, StringComparer.Ordinal))
            {
              <a href="#" class="badge">@tag</a>
            }
          </div>
        }
      </article>
    }
  </section>
</main>
