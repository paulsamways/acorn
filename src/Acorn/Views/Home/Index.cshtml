@model IEnumerable<Acorn.Core.ContentManagement.Models.Content>

<main class="f-grow-1 f-column f-align-center">

  <section class="f-column w-wide g-4 p-4" aria-label="Recent activity">
    <h3>Recent activity</h3>
    @foreach (var content in Model)
    {
      <article class="f-column g-2">
        <header class="f-column g-1">
          <h3>
            @if (content is Acorn.Core.ContentManagement.Models.Post post)
            {
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
              </svg>
              <a asp-route="@Routes.PostsDetailsGetRoute" asp-route-id="@post.Id">@post.Title</a>
            }
            else if (content is Acorn.Core.ContentManagement.Models.Bookmark bookmark)
            {
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
              </svg>
              <a href="@bookmark.Url" target="_blank" rel="noopener noreferrer">
                @bookmark.Title
              </a>
            }
            else if (content is Acorn.Core.ContentManagement.Models.Note)
            {
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
              </svg>
              <span>Note</span>
            }
          </h3>
          <div class="f-row g-2">
            <span class="muted">@content.GetType().Name</span>&mdash;
            <time class="muted" datetime="@content.UpdatedAt" title="Published at {0}" display="Date"></time>
          </div>
        </header>
        @if (content is Acorn.Core.ContentManagement.Models.Post postContent)
        {
          <div class="prose">@Html.Raw(postContent.ExcerptHtml ?? postContent.BodyHtml)</div>
        }
        else if (content is Acorn.Core.ContentManagement.Models.Bookmark bookmarkContent && bookmarkContent.DescriptionHtml is not null)
        {
          <div class="prose">@Html.Raw(bookmarkContent.DescriptionHtml)</div>
        }
        else if (content is Acorn.Core.ContentManagement.Models.Note noteContent)
        {
          <div class="prose">@Html.Raw(noteContent.ValueHtml)</div>
        }
        @if (content.Tags.Count > 0)
        {
          <div class="f-row f-justify-end g-2">
            @foreach (var tag in content.Tags.OrderBy(tag => tag, StringComparer.Ordinal))
            {
              <a href="#" class="badge">@tag</a>
            }
          </div>
        }
      </article>
    }
  </section>
</main>
