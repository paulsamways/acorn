@using Acorn.Core.ContentManagement
@model Acorn.Models.Comments.CommentResultViewModel
@{
  ViewData["Title"] = "Comment received";
}

<main class="f-grow-1 f-column f-align-center">
  <div class="w-narrow f-column g-3 p-4">
    @switch (Model.State)
    {
      case ContentCommentState.Unverified:
        <h2>Check your email</h2>
        <p>We've sent you a link to verify your comment. Your comment will not be shown until you follow it.</p>
        break;
      case ContentCommentState.Verified:
        <h2>Thanks, you're verified</h2>
        <p>Your comment is awaiting approval and will appear once it has been approved.</p>
        break;
      case ContentCommentState.Approved:
        <h2>Comment published</h2>
        <p>Thanks, your comment is now visible.</p>
        break;
      default:
        <h2>Comment received</h2>
        <p>Thanks for your comment.</p>
        break;
    }

    <a asp-route="@Routes.ContentPostsDetailsGetRoute" asp-route-id="@Model.ContentId" asp-fragment="@(Model.State == ContentCommentState.Approved && Model.CommentId is { } id ? $"comment-{id}" : "comments")">Back to the post</a>
  </div>
</main>
