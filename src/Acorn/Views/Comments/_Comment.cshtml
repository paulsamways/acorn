@model Acorn.Core.ContentManagement.Models.ContentComment

<article id="comment-@Model.Id" class="f-column g-2">
  <header class="f-row g-2 f-align-center">
    <strong>@Model.AuthorName</strong>
    <time class="muted small-text" datetime="@Model.CreatedAt" display="Date"></time>
  </header>

  <div class="prose">
    @Html.Raw(Model.BodyHtml)
  </div>

  <div>
    <a class="small-text" asp-route="@Routes.ContentCommentsNewGetRoute" asp-route-contentId="@Model.ContentId" asp-route-parent="@Model.Id">Reply</a>
  </div>

  @if (Model.Replies.Count > 0)
  {
    <div class="f-column g-3 ml-4">
      @foreach (var reply in Model.Replies)
      {
        <partial name="~/Views/Comments/_Comment.cshtml" model="reply" />
      }
    </div>
  }
</article>
