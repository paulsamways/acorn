@model Acorn.Models.Comments.CommentVerifyViewModel
@{
  ViewData["Title"] = "Verify your comment";
}

<main class="f-grow-1 f-column f-align-center">
  <form class="w-narrow f-column g-3 p-4" asp-route="@Routes.ContentCommentsVerifyPostRoute" method="POST">
    <h2>Verify your comment</h2>
    <p>Confirm that you wrote this comment.</p>

    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="token" value="@Model.Token" />

    <label class="f-row g-2 f-align-center">
      <input type="checkbox" name="remember" value="true" />
      <span>Don't ask me to verify again on this browser</span>
    </label>

    <button type="submit">Verify comment</button>
  </form>
</main>
