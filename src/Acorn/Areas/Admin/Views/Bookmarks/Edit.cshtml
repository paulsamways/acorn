@model Acorn.Areas.Admin.Models.Bookmarks.EditViewModel

<main class="f-column f-align-center">
  <div class="f-column w-wide g-4 p-4">
    <header class="f-row f-justify-space-between f-align-center">
      <h2>@(Model.Id == 0 ? "New bookmark" : "Edit bookmark")</h2>
      @if (Model.PublishedAt is null)
      {
        <form asp-route="@Routes.Admin.BookmarksPublishPostRoute" asp-route-id="@Model.Id" method="POST">
          <button type="submit">Publish</button>
        </form>
      }
      else
      {
        <span class="muted">Published @Model.PublishedAt.Value</span>
      }
    </header>

    <form class="f-column g-3" asp-route="@Routes.Admin.BookmarksEditPostRoute" asp-route-id="@Model.Id" method="POST" data-bookmark-metadata-url="@Url.RouteUrl(Routes.Admin.BookmarksMetadataPostRoute)">
      <div asp-validation-summary="All" class="danger"></div>

      <label asp-for="Url">URL</label>
      <input asp-for="Url" type="url" />
      <span asp-validation-for="Url" class="danger"></span>
      <p class="muted" data-bookmark-metadata-status aria-live="polite"></p>

      <label asp-for="Title">Title</label>
      <input asp-for="Title" />
      <span asp-validation-for="Title" class="danger"></span>

      <label asp-for="Description">Description (Markdown)</label>
      <textarea asp-for="Description" rows="5"></textarea>
      <span asp-validation-for="Description" class="danger"></span>

      <label asp-for="Tags">Tags</label>
      <input asp-for="Tags" />
      <span asp-validation-for="Tags" class="danger"></span>

      <div class="f-row f-justify-space-between">
        @if (Model.Id > 0)
        {
          <a asp-route="@Routes.Admin.BookmarksArchiveGetRoute" asp-route-id="@Model.Id" role="button" class="danger">Archive</a>
        }
        <button type="submit">Save changes</button>
      </div>
    </form>
  </div>
</main>

@section Scripts {
  <script src="~/js/bookmark-metadata.js" defer asp-append-version="true"></script>
}
