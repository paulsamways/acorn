@model IEnumerable<Acorn.Core.ContentManagement.Models.Note>

<main>
  <div class="f-column f-align-center g-5">
      <form class="w-wide p-4 f-row f-justify-end" asp-route="@Routes.Admin.NotesIndexPostRoute" method="POST">
        <button type="submit">New Note</button>
      </form>
      @foreach (var note in Model)
      {
        <div class="f-column w-wide p-4 g-1">
          <div class="prose">
            @Html.Raw(note.ValueHtml)
          </div>
          @if (note.Tags.Count > 0)
          {
            <p class="muted">@string.Join(", ", note.Tags.OrderBy(tag => tag, StringComparer.Ordinal))</p>
          }
          <div class="f-row f-justify-space-between">
            <div>
              <a asp-route="@Routes.Admin.NotesEditGetRoute" asp-route-id="@note.Id">Edit</a>
            </div>
            <div class="muted">
              @note.CreatedAt
            </div>
          </div>
        </div>
      }
  </div>
</main>
