@using Acorn.Areas.Admin.Models.Notes
@model EditViewModel

<main class="f-column f-align-center">

  <div class="f-column w-wide g-4 p-4">
    <header class="f-row f-justify-space-between f-align-center">
      <h2>Note</h2>
    </header>

    <form class="f-column g-3" asp-route="@Routes.Admin.NotesEditPostRoute" asp-route-id="@Model.Id" method="POST">
      <div asp-validation-summary="All" class="danger"></div>
      @await Component.InvokeAsync("ConcurrencyError", new { model = Model, latestVersionRoute = Routes.Admin.NotesEditGetRoute })
      <input asp-for="ConcurrencyToken" type="hidden" />

      <markdown-editor id="Value" name="Value" rows="24" image-upload-url="@(Url.RouteUrl(Routes.Admin.AttachFilePostRoute, new { id = Model.Id }))" file-upload-url="@(Url.RouteUrl(Routes.Admin.AttachFilePostRoute, new { id = Model.Id }))">@Model.Value</markdown-editor>

      <details>
        <summary>Optional fields</summary>
        <div class="f-column g-3 p-3">
          <label asp-for="Tags">Tags</label>
          <input asp-for="Tags" />
          <span asp-validation-for="Tags" class="danger"></span>

          <label>
            <input asp-for="Published" type="checkbox"" /> Published
          </label>

        </div>
      </details>




      <div class="f-row f-justify-space-between">
        <div>
          <a asp-route="@Routes.Admin.NotesDeleteGetRoute" asp-route-id="@Model.Id" role="button" class="danger">Delete</a>
        </div>
        <div>
          <button type="submit">Save changes</button>
        </div>
      </div>
    </form>
  </div>
</main>
