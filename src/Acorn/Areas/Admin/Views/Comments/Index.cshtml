@addTagHelper *, Acorn
@using Acorn.Core.ContentManagement
@model IReadOnlyList<Acorn.Core.ContentManagement.Models.ContentCommentModerationItem>
@{
  var current = ViewData["State"] as ContentCommentState?;
}

<main class="f-column f-align-center">
  <header class="w-wide p-4 f-column g-3">
    <h2>Comments</h2>
    <nav class="f-row g-3">
      <a asp-route="@Routes.Admin.CommentsIndexGetRoute" class="@(current is null ? "b" : null)">All</a>
      @foreach (var state in Enum.GetValues<ContentCommentState>())
      {
        <a asp-route="@Routes.Admin.CommentsIndexGetRoute" asp-route-state="@state" class="@(current == state ? "b" : null)">@state</a>
      }
    </nav>
  </header>

  <div class="f-column w-wide g-3 p-4">
    @if (Model.Count == 0)
    {
      <p class="muted">No comments.</p>
    }

    @foreach (var comment in Model)
    {
      <article class="f-column g-2 p-3">
        <div class="f-row f-justify-space-between f-align-center">
          <div class="f-column">
            <strong>@comment.AuthorName</strong>
            <span class="muted small-text">
              @(comment.IsEmailAnonymised ? "Email removed" : comment.AuthorEmail)
              &mdash; on <a asp-route="@Routes.ContentPostsDetailsGetRoute" asp-route-id="@comment.ContentId" asp-fragment="comment-@comment.Id">@comment.ContentTitle</a>
              @if (comment.ParentCommentId is not null)
              {
                <span>(reply)</span>
              }
            </span>
          </div>
          <span class="muted">@comment.State</span>
        </div>

        <div class="prose">
          @Html.Raw(comment.BodyHtml)
        </div>

        <div class="muted small-text">
          Submitted <time datetime="@comment.CreatedAt" display="DateTime"></time>
        </div>

        <div class="f-row g-3">
          @if (comment.State == ContentCommentState.Verified)
          {
            <form asp-route="@Routes.Admin.CommentsApprovePostRoute" asp-route-id="@comment.Id" method="POST">
              <input type="hidden" name="concurrencyToken" value="@comment.ConcurrencyToken" />
              <input type="hidden" name="state" value="@current" />
              <button type="submit">Approve</button>
            </form>
          }
          @if (comment.State == ContentCommentState.Hidden && comment.VerifiedAt is not null)
          {
            <form asp-route="@Routes.Admin.CommentsUnhidePostRoute" asp-route-id="@comment.Id" method="POST">
              <input type="hidden" name="concurrencyToken" value="@comment.ConcurrencyToken" />
              <input type="hidden" name="state" value="@current" />
              <button type="submit">Approve</button>
            </form>
          }
          @if (comment.State != ContentCommentState.Hidden)
          {
            <form asp-route="@Routes.Admin.CommentsHidePostRoute" asp-route-id="@comment.Id" method="POST">
              <input type="hidden" name="concurrencyToken" value="@comment.ConcurrencyToken" />
              <input type="hidden" name="state" value="@current" />
              <button type="submit">Hide</button>
            </form>
          }
          @if (comment.State is ContentCommentState.Unverified or ContentCommentState.Verified)
          {
            <form asp-route="@Routes.Admin.CommentsDeletePostRoute" asp-route-id="@comment.Id" method="POST" onsubmit="return confirm('Permanently delete this comment? This cannot be undone.');">
              <input type="hidden" name="concurrencyToken" value="@comment.ConcurrencyToken" />
              <input type="hidden" name="state" value="@current" />
              <button type="submit">Delete</button>
            </form>
          }
          @if (!comment.IsEmailAnonymised)
          {
            <form asp-route="@Routes.Admin.CommentsAnonymisePostRoute" asp-route-id="@comment.Id" method="POST">
              <input type="hidden" name="concurrencyToken" value="@comment.ConcurrencyToken" />
              <input type="hidden" name="state" value="@current" />
              <button type="submit">Remove email</button>
            </form>
          }
        </div>
      </article>
    }
  </div>
</main>
